{
  "scripts": {
    "build": "vite build",
    "start": "vite",
    "test": "vitest run --coverage",
    "check": "npm run check:html && npm run check:css && npm run check:js && npm run check:ts",
    "check:html": "html-validate '*.html'",
    "check:css": "stylelint '**/*.css'",
    "check:js": "eslint",
    "check:ts": "tsc --noEmit",
    "format": "prettier . --write"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.7",
    "@fontsource-variable/fira-code": "^5.3.0",
    "@picocss/pico": "^2.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fast-check/vitest": "^0.4.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "html-validate": "^11.6.0",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0"
  }
}
